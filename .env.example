# PayPal SANDBOX credentials: developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Optional: enables webhook signature verification (Developer Dashboard -> your app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# AI Provider Key (Gemini, Anthropic, or DeepSeek)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
AI_MODEL=gemini-2.5-flash

# Autonomous Agent Engine Config
AGENT_SECRET=your_secure_agent_secret_here
AGENT_ENABLED=true
AGENT_MAX_ACTIONS=5

# Indicative fallback FX rates for the INR estimate (live rate is automatically fetched & cached)
FX_USD_INR=87
FX_EUR_INR=95
FX_GBP_INR=112
